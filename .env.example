# App
APP_NAME=EDB Circulars
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=000000
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Database
POSTGRES_USER=edb
POSTGRES_PASSWORD=edb_secret
POSTGRES_DB=edb_circulars
DATABASE_URL=postgresql+asyncpg://edb:edb_secret@db:5432/edb_circulars

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MinIO (optional; default is local filesystem)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/files
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edb-docs
MINIO_PUBLIC_URL=http://localhost:9000

# AI — OpenRouter (LLM) + Jina (embeddings)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024

# Optional local LLM fallback (slow; not default)
LLM_PROVIDER=openrouter
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Crawl
CRAWL_USER_AGENT=EDBCircularsBot/1.0 (+local school use; polite crawl)
CRAWL_RATE_LIMIT_SECONDS=1.5
CRAWL_ENABLED=true

# Optional Dify (default off)
DIFY_ENABLED=false
DIFY_API_URL=http://dify-api:5001
DIFY_DATASET_API_KEY=
DIFY_APP_API_KEY=
DIFY_DATASET_ID=

# Phase-2 Google OAuth (stub; leave empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web
# Local: http://127.0.0.1:8008
# Coolify/production: set to public HTTPS API URL, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8008
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK
